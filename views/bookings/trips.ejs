<% layout("/layouts/boilerplate") %>


<div class="container mt-5">

<h2 class="mb-4">
    My Trips
</h2>


<h4>
    Upcoming Bookings
</h4>


<div class="row">

<% if(upcomingBookings.length === 0){ %>

<p>No upcoming trips</p>

<% } %>


<% upcomingBookings.forEach(booking => { %>


<div class="col-md-6 mb-4">

<div class="card shadow">


<img 
src="<%= booking.listing.images[0].url %>"
class="card-img-top"
height="250"
>


<div class="card-body">


<h5>
<%= booking.listing.title %>
</h5>


<p>
Check In:
<%= booking.checkIn.toDateString() %>
</p>


<p>
Check Out:
<%= booking.checkOut.toDateString() %>
</p>


<p>
Status:
<span class="badge bg-success">
<%= booking.status %>
</span>
</p>



<a 
href="/booking/confirm/<%= booking._id %>"
class="btn btn-dark">
View Booking
</a>



<a 
href="/booking/<%= booking._id %>/invoice"
class="btn btn-primary">
Invoice
</a>



<form 
method="POST"
action="/booking/<%= booking._id %>?_method=DELETE"
class="d-inline">

<button 
class="btn btn-danger">
Cancel
</button>

</form>


</div>

</div>

</div>


<% }) %>

</div>



<hr>



<h4>
Past Trips
</h4>


<div class="row">


<% pastBookings.forEach(booking => { %>


<div class="col-md-6 mb-4">


<div class="card">


<div class="card-body">


<h5>
<%= booking.listing.title %>
</h5>


<p>
Status:
<%= booking.status %>
</p>


<a 
href="/booking/confirm/<%= booking._id %>"
class="btn btn-secondary">

View Booking

</a>


</div>

</div>


</div>


<% }) %>


</div>


</div>