<% layout("/layouts/boilerplate") %>

<div class="container py-5">

    <div class="row">

        <div class="col-lg-8">

        <% if (bookingType === "cancelled") { %>

<div class="alert alert-danger rounded-4 shadow-sm mb-4">
    <h4 class="mb-2">❌ Booking Cancelled</h4>
    <p class="mb-0">
        This booking has been cancelled.
    </p>
</div>

<% } else if (bookingType === "completed") { %>

<div class="alert alert-info rounded-4 shadow-sm mb-4">
    <h4 class="mb-2">🏡 Stay Completed</h4>
    <p class="mb-0">
        Hope you enjoyed your stay with NikStays!
    </p>
</div>

<% } else { %>

<div class="alert alert-success rounded-4 shadow-sm mb-4">
    <h4 class="mb-2">🎉 Booking Confirmed</h4>
    <p class="mb-0">
        Your stay has been successfully reserved.
        We look forward to hosting you!
    </p>
</div>

<% } %>

         <div class="card shadow border-0 rounded-4 overflow-hidden">

                <img
src="<%= booking.listing.images?.[0]?.url || booking.listing.image?.url || 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=1200' %>"                    class="card-img-top"
                    style="height:400px; object-fit:cover;"
                >

                <div class="card-body p-4">

                    <h2 class="fw-bold">
                        <%= booking.listing.title %>
                    </h2>

                    <p class="text-muted mb-4">
                        <i class="fa-solid fa-location-dot"></i>
                        <%= booking.listing.location %>,
                        <%= booking.listing.country %>
                    </p>

                    <hr>

                    <div class="row text-center">

                        <div class="col-md-4 mb-3">

                            <h6 class="text-muted">
                                Check-In
                            </h6>

                            <h5>
                                <%= booking.checkIn.toDateString() %>
                            </h5>

                        </div>

                        <div class="col-md-4 mb-3">

                            <h6 class="text-muted">
                                Check-Out
                            </h6>

                            <h5>
                                <%= booking.checkOut.toDateString() %>
                            </h5>

                        </div>

                        <div class="col-md-4 mb-3">

                            <h6 class="text-muted">
                                Nights
                            </h6>

                            <h5>
                                <%= nights %>
                            </h5>

                        </div>

                    </div>

                    <hr>

                    <div class="row">

                        <div class="col-md-6">

                            <h6 class="text-muted">
                                Guest
                            </h6>

                            <h5>
                                <%= booking.user.username %>
                            </h5>

                        </div>

                        <div class="col-md-6">

                            <h6 class="text-muted">
                                Guests
                            </h6>

                            <h5>
                                <%= booking.guests %>
                            </h5>

                        </div>

                    </div>

                    <hr>

                    <div class="row">

                        <div class="col-md-6">

                            <h6 class="text-muted">
                                Booking Status
                            </h6>

                            <span class="badge fs-6
                            <%= booking.status === 'confirmed'
                                ? 'bg-success'
                                : booking.status === 'cancelled'
                                ? 'bg-danger'
                                : 'bg-secondary' %>">

                                <%= booking.status.toUpperCase() %>

                            </span>

                        </div>

                        <div class="col-md-6">

                            <h6 class="text-muted">
                                Payment
                            </h6>

                            <span class="badge fs-6
                            <%= booking.paymentStatus === 'SUCCESS'
                                ? 'bg-success'
                                : booking.paymentStatus === 'FAILED'
                                ? 'bg-danger'
                                : 'bg-warning text-dark' %>">

                                <%= booking.paymentStatus %>

                            </span>

                        </div>

                    </div>

                    <hr>
                    <h4 class="fw-bold mt-4 mb-4">
    Your Host
</h4>

<div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-body d-flex align-items-center">

        <img
            src="https://ui-avatars.com/api/?name=<%= booking.listing.owner.username %>&background=8B0000&color=fff&size=128"
            width="70"
            height="70"
            class="rounded-circle me-3"
        >

        <div>

            <h5 class="mb-1">
                <%= booking.listing.owner.username %>
            </h5>

            <p class="text-muted mb-0">
                Super Host • NikStays
            </p>

        </div>

    </div>

</div>

<div class="row">

    <div class="col-md-6">

        <h6 class="text-muted">
            Transaction ID
        </h6>

        <p class="fw-semibold">
            <%= booking.transactionId %>
        </p>

    </div>

    <div class="col-md-6">

        <h6 class="text-muted">
            Payment Method
        </h6>

        <p class="fw-semibold">
            Online Payment
        </p>

    </div>

</div>

                    <hr>

<h4 class="fw-bold mb-4">
    Booking Timeline
</h4>

<ul class="list-group list-group-flush">

    <li class="list-group-item d-flex justify-content-between">

        <span>
            Booking Created
        </span>

        <strong>
            ✔ Completed
        </strong>

    </li>

    <li class="list-group-item d-flex justify-content-between">

        <span>
            Payment Received
        </span>

        <strong class="text-success">
            ✔ Success
        </strong>

    </li>

    <li class="list-group-item d-flex justify-content-between">

        <span>
            Check-In
        </span>

        <strong>
            <%= booking.checkIn.toDateString() %>
        </strong>

    </li>

    <li class="list-group-item d-flex justify-content-between">

        <span>
            Check-Out
        </span>

        <strong>
            <%= booking.checkOut.toDateString() %>
        </strong>

    </li>

</ul>

                </div>

            </div>

        </div>

        <div class="col-lg-4 mt-4 mt-lg-0">

            <div class="card shadow border-0 rounded-4">

                <div class="card-body">

                    <h3 class="mb-4">
                        Price Details
                    </h3>

                    <div class="d-flex justify-content-between">

                        <span>Stay Cost</span>

                        <strong>
                            ₹<%= booking.totalPrice - (500 + 350) %>
                        </strong>

                    </div>

                    <div class="d-flex justify-content-between mt-3">

                        <span>Cleaning Fee</span>

                        <strong>₹500</strong>

                    </div>

                    <div class="d-flex justify-content-between mt-3">

                        <span>Service Fee</span>

                        <strong>₹350</strong>

                    </div>

                    <hr>

                    <div class="d-flex justify-content-between">

                        <h5>Total Paid</h5>

                        <h5>
                            ₹<%= booking.totalPrice %>
                        </h5>

                    </div>

                    <a
                        href="/booking/<%= booking._id %>/invoice"
                        class="btn btn-dark w-100 mt-4"
                    >
                        <i class="fa-solid fa-file-pdf"></i>
                        Download Invoice
                    </a>

                    <% if(bookingType==="upcoming"){ %>

                    <form
                        action="/booking/<%= booking._id %>?_method=DELETE"
                        method="POST"
                        class="mt-3"
                    >

                        <button class="btn btn-danger w-100">

                            Cancel Booking

                        </button>

                    </form>

                    <% } %>

                    <% if(bookingType==="completed"){ %>

                    <a
                        href="/listings/<%= booking.listing._id %>"
                        class="btn btn-success w-100 mt-3"
                    >
                        Leave Review
                    </a>

                    <% } %>

                </div>

            </div>

        </div>

    </div>

</div>