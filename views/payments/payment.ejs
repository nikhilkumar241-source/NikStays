<% layout("/layouts/boilerplate") %>


<div class="container py-5">


    <div class="row justify-content-center">


        <div class="col-lg-6">


            <div class="card shadow rounded-4 border-0 p-4">


                <h2 class="fw-bold mb-4 text-center">
                    Complete Payment 💳
                </h2>



                <div class="bg-light rounded-4 p-3 mb-4">


                    <h5 class="fw-bold">
                        <%= booking.listing.title %>
                    </h5>


                    <p class="text-muted mb-1">

                        📍 <%= booking.listing.location %>,
                        <%= booking.listing.country %>

                    </p>


                    <hr>


                    <p>
                        <strong>Check-in:</strong>
                        <%= booking.checkIn.toDateString() %>
                    </p>


                    <p>
                        <strong>Check-out:</strong>
                        <%= booking.checkOut.toDateString() %>
                    </p>


                    <p>
                        <strong>Guests:</strong>
                        <%= booking.guests %>
                    </p>


                    <hr>


                    <h4 class="text-danger fw-bold">

                        Total:
                        ₹ <%= booking.totalPrice.toLocaleString("en-IN") %>

                    </h4>


                </div>



                 <button
class="btn btn-dark w-100 rounded-pill py-3 fw-bold">

💳 Complete Payment ₹ <%= booking.totalPrice.toLocaleString("en-IN") %>

</button>


<p class="text-center text-muted mt-3 small">
    This is a demo payment system for NikStays.
</p>



            </div>


        </div>


    </div>


</div>



<script>

const payBtn =
document.getElementById("payBtn");


payBtn.addEventListener("click",()=>{


    payBtn.disabled = true;


    payBtn.innerHTML = `

    <span class="spinner-border spinner-border-sm"></span>
    Processing Payment...

    `;



    setTimeout(()=>{


        window.location.href =
        "/payment/<%= booking._id %>/success";


    },2000);



});


</script>