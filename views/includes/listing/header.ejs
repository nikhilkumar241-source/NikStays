<!-- Listing Header -->

<div class="d-flex justify-content-between align-items-center flex-wrap mb-4">


    <div>

        <h2 class="fw-bold mb-2">
            <%= listing.title %>
        </h2>


        <div>

            <i class="fa-solid fa-star text-danger"></i>

            <strong>
                4.92
            </strong>

            ·

            <span class="text-decoration-underline">
                125 Reviews
            </span>

            ·

            <span class="text-decoration-underline">

                <%= listing.location %>, 
                <%= listing.country %>

            </span>

        </div>

    </div>




    <div class="mt-3 mt-md-0">


        <button
            id="shareBtn"
            class="btn btn-light border rounded-pill me-2">


            <i class="fa-solid fa-arrow-up-from-bracket"></i>

            Share


        </button>





        <button
            id="saveBtn"
            class="btn btn-light border rounded-pill"
            data-id="<%= listing._id %>">


            <i class="fa-regular fa-heart"></i>


            <span>
                Save
            </span>


        </button>


    </div>


</div>