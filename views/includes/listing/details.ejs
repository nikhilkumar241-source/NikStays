<!-- ================= LISTING DETAILS ================= -->


<div class="d-flex justify-content-between align-items-center">


    <div>


        <h3 class="fw-bold">

            Hosted by <%= listing.owner.username %>

        </h3>


        <p class="text-muted mb-0">

            Entire home · 4 guests · 2 bedrooms · 2 beds · 2 bathrooms

        </p>


    </div>



    <div>


        <img

            src="https://i.pravatar.cc/150"

            class="rounded-circle"

            width="75"

            height="75"

        >


    </div>


</div>





<hr class="my-4">





<!-- Features -->


<div class="row text-center mb-5">


    <div class="col-md-4">


        <i class="fa-solid fa-medal fa-2x mb-2"></i>


        <h6>

            Superhost

        </h6>


        <small class="text-muted">

            Experienced host with excellent reviews

        </small>


    </div>





    <div class="col-md-4">


        <i class="fa-solid fa-door-open fa-2x mb-2"></i>


        <h6>

            Self Check-in

        </h6>


        <small class="text-muted">

            Check yourself in easily

        </small>


    </div>





    <div class="col-md-4">


        <i class="fa-solid fa-calendar-check fa-2x mb-2"></i>


        <h6>

            Free Cancellation

        </h6>


        <small class="text-muted">

            Cancel before check-in

        </small>


    </div>



</div>





<hr>





<h4 class="fw-bold mb-3">

    About this place

</h4>



<p class="text-muted fs-6">

    <%= listing.description %>

</p>





<hr class="my-5">





<h4 class="fw-bold mb-4">

    What this place offers

</h4>




<div class="row">


    <div class="col-md-6 mb-3">

        <i class="fa-solid fa-wifi me-2"></i>

        Free WiFi

    </div>



    <div class="col-md-6 mb-3">

        <i class="fa-solid fa-car me-2"></i>

        Free Parking

    </div>



    <div class="col-md-6 mb-3">

        <i class="fa-solid fa-kitchen-set me-2"></i>

        Kitchen

    </div>



    <div class="col-md-6 mb-3">

        <i class="fa-solid fa-tv me-2"></i>

        Smart TV

    </div>



    <div class="col-md-6 mb-3">

        <i class="fa-solid fa-snowflake me-2"></i>

        Air Conditioning

    </div>



    <div class="col-md-6 mb-3">

        <i class="fa-solid fa-person-swimming me-2"></i>

        Swimming Pool

    </div>



    <div class="col-md-6 mb-3">

        <i class="fa-solid fa-shirt me-2"></i>

        Washing Machine

    </div>



    <div class="col-md-6 mb-3">

        <i class="fa-solid fa-mug-hot me-2"></i>

        Coffee Maker

    </div>


</div>





<hr class="my-5">





<!-- House Rules -->


<h4 class="fw-bold mb-4">

    House Rules

</h4>



<div class="row">


    <div class="col-md-6 mb-3">

        <i class="fa-solid fa-clock me-2"></i>

        Check-in: After <strong>2:00 PM</strong>

    </div>



    <div class="col-md-6 mb-3">

        <i class="fa-solid fa-clock me-2"></i>

        Checkout: Before <strong>11:00 AM</strong>

    </div>



    <div class="col-md-6 mb-3">

        <i class="fa-solid fa-ban-smoking me-2"></i>

        No Smoking

    </div>



    <div class="col-md-6 mb-3">

        <i class="fa-solid fa-paw me-2"></i>

        Pets Allowed

    </div>



    <div class="col-md-6 mb-3">

        <i class="fa-solid fa-volume-xmark me-2"></i>

        No Loud Parties

    </div>



    <div class="col-md-6 mb-3">

        <i class="fa-solid fa-child-reaching me-2"></i>

        Family Friendly

    </div>


</div>





<hr class="my-5">





<!-- Safety -->


<h4 class="fw-bold mb-4">

    Safety & Property

</h4>



<div class="row">


    <div class="col-md-6 mb-4">


        <i class="fa-solid fa-fire-extinguisher fa-xl mb-3"></i>


        <h6>

            Safety

        </h6>


        <p class="text-muted mb-0">

            Smoke alarm installed

        </p>


        <p class="text-muted mb-0">

            Fire extinguisher available

        </p>


        <p class="text-muted">

            First aid kit available

        </p>


    </div>





    <div class="col-md-6 mb-4">


        <i class="fa-solid fa-house-circle-check fa-xl mb-3"></i>


        <h6>

            Property

        </h6>


        <p class="text-muted mb-0">

            No smoking inside

        </p>


        <p class="text-muted mb-0">

            No parties or events

        </p>


        <p class="text-muted">

            Keep noise low after 10 PM

        </p>


    </div>


</div>