<!-- =========================================================
     IMAGE GALLERY
========================================================= -->

<%
    let galleryImages = [];

    if (listing.images && listing.images.length > 0) {
        galleryImages = listing.images;
    } else if (listing.image) {
        galleryImages = [listing.image];
    }
%>

<% if (galleryImages.length > 0) { %>

<div class="airbnb-gallery">

    <!-- MAIN IMAGE -->
    <div class="gallery-main">

        <img
            src="<%= galleryImages[0].url %>"
            class="gallery-image"
            data-index="0"
            data-bs-toggle="modal"
            data-bs-target="#imageModal"
            alt="<%= listing.title %>"
        >

    </div>


    <!-- RIGHT SIDE IMAGES -->
    <div class="gallery-grid">

        <% for(let i = 1; i <= 4; i++) { %>

            <% if(galleryImages[i]) { %>

                <div class="gallery-small">

                    <img
                        src="<%= galleryImages[i].url %>"
                        class="gallery-image"
                        data-index="<%= i %>"
                        data-bs-toggle="modal"
                        data-bs-target="#imageModal"
                        alt="<%= listing.title %>"
                    >

                </div>

            <% } else { %>

                <div class="gallery-small gallery-placeholder"></div>

            <% } %>

        <% } %>

    </div>

</div>


<!-- SHOW ALL PHOTOS -->

<div class="gallery-actions">

    <button
        type="button"
        class="show-all-photos"
        data-bs-toggle="modal"
        data-bs-target="#imageModal"
    >

        <i class="fa-solid fa-images"></i>

        Show all photos

    </button>

</div>

<% } %>