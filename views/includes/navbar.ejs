<style>

.search-btn {
  border-radius:25px;
  background-color:rgb(165,3,3);
  color:white;
  padding:0 1rem;
}

.search-btn:hover{
  background-color:rgb(130,0,0);
  color:white;
}

.search-btn i{
  margin-right:.5rem;
}

.search-inp{
  border-radius:25px;
  padding:.5rem 3rem;
  font-size:1rem;
}

.navbar-brand{
  display:flex;
  align-items:center;
  text-decoration:none;
}

.navbar-brand i{
  font-size:2.4rem;
  color:rgb(155,3,3);
}

.brand-name{
  font-size:1.4rem;
  font-weight:600;
  color:rgb(155,3,3);
  font-family:Arial, Helvetica, sans-serif;
  margin-left:4px;
}

.nav-link{
  font-weight:500;
}

.nav-link:hover{
  color:rgb(165,3,3);
}

</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">

    <div class="container-fluid">

        <a class="navbar-brand" href="/listings">

            <i class="fa-solid fa-naira-sign"></i>

            <span class="brand-name">
                NikStays
            </span>

        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavAltMarkup">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div
            class="collapse navbar-collapse"
            id="navbarNavAltMarkup">

            <!-- Search -->

            <div class="navbar-nav mx-auto">

                <form
                    class="d-flex"
                    role="search"
                    action="/listings"
                    method="GET">

                    <input
                        class="form-control me-2 search-inp"
                        type="search"
                        name="search"
                        placeholder="Search destinations"
                        value="<%= typeof search !== 'undefined' ? search : '' %>"
                    />

                    <button
                        class="btn search-btn"
                        type="submit">

                        <i class="fa-solid fa-magnifying-glass"></i>
                        Search

                    </button>

                </form>

            </div>

            <!-- Right Menu -->

            <div class="navbar-nav ms-auto">

                <a
                    class="nav-link"
                    href="/listings/new">

                    <i class="fa-solid fa-plus"></i>
                    New Listing

                </a>

                <% if(!currUser){ %>

                    <a
                        class="nav-link"
                        href="/signup">

                        <b>Sign Up</b>

                    </a>

                    <a
                        class="nav-link"
                        href="/login">

                        <b>Log In</b>

                    </a>

                <% } else { %>

                    <a
                        class="nav-link"
                        href="/wishlist">

                        ❤️ Wishlist

                    </a>

                    <a
                        class="nav-link"
                        href="/trips">

                        ✈️ Trips

                    </a>

                    <a
                    class="nav-link"
                    href="/profile">

                    <i class="fa-solid fa-user"></i>

                    Profile

                    </a>

                    <% if(isHost){ %>

                        <a
                            class="nav-link"
                            href="/dashboard">

                            <i class="fa-solid fa-chart-line"></i>
                            Dashboard

                        </a>

                    <% } %>

                    <a
                        class="nav-link"
                        href="/logout">

                        <i class="fa-solid fa-right-from-bracket"></i>
                        Logout

                    </a>

                <% } %>
                

            </div>

        </div>

    </div>

</nav>