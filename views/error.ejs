<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="alert alert-danger col-6 offset-3" role="alert">
        <h4 class="alert-heading"><%= message || "Something went wrong!" %></h4>
        <% if (typeof err !== 'undefined' && err.trace) { %>
            <p><%= err.trace %></p>
        <% } %>
    </div>
</div>