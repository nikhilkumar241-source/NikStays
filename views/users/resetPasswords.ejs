<% layout("/layouts/boilerplate") %>

<div class="container col-md-6 mt-5">

    <h2 class="mb-4 text-center">
        Reset Password
    </h2>

    <form action="/reset-password/<%= token %>" method="POST">

        <div class="mb-3">
            <label class="form-label">
                New Password
            </label>

            <input
                type="password"
                name="password"
                class="form-control"
                minlength="6"
                required
            >
        </div>

        <button class="btn btn-success w-100">
            Reset Password
        </button>

    </form>

</div>