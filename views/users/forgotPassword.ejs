<h2>Forgot Password</h2>

<form action="/forgot-password" method="POST">

<div class="mb-3">
<label>Email</label>

<input
type="email"
name="email"
class="form-control"
required>
</div>

<button class="btn btn-danger">
Send Reset Link
</button>

</form>

</div>