<% layout("/layouts/boilerplate") %>

<style>
#filters{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    margin-top:1rem;
}

.filter{
    text-align:center;
    margin-right:2rem;
    margin-top:1rem;
    opacity:.7;
}

.filter:hover{
    opacity:1;
    cursor:pointer;
}

.tax-info{
    display:none;
}

.tax-toggle{
    border:1px solid #000;
    border-radius:1rem;
    height:3.25rem;
    padding:1rem;
    margin-left:2rem;
    display:flex;
    align-items:center;
}
</style>

<!-- FILTERS -->

<div id="filters">

    <a href="/listings?category=Trending" class="filter listing-link">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </a>

    <a href="/listings?category=Rooms" class="filter listing-link">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </a>

    <a href="/listings?category=Iconic Cities" class="filter listing-link">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
    </a>

    <a href="/listings?category=Mountains" class="filter listing-link">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountain</p>
    </a>

    <a href="/listings?category=Historical" class="filter listing-link">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Historical</p>
    </a>

    <a href="/listings?category=Beach" class="filter listing-link">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Beach</p>
    </a>

    <a href="/listings?category=Camping" class="filter listing-link">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </a>

    <a href="/listings?category=Farmhouse" class="filter listing-link">
        <div><i class="fa-solid fa-tractor"></i></div>
        <p>Farmhouse</p>
    </a>

    <a href="/listings?category=Food" class="filter listing-link">
        <div><i class="fa-solid fa-burger"></i></div>
        <p>Food</p>
    </a>

    <a href="/listings?category=Domes" class="filter listing-link">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
    </a>

    <a href="/listings?category=Lake" class="filter listing-link">
        <div><i class="fa-solid fa-sailboat"></i></div>
        <p>Lake</p>
    </a>

    <a href="/listings?category=Ocean" class="filter listing-link">
        <div><i class="fa-solid fa-anchor"></i></div>
        <p>Ocean</p>
    </a>

    <div class="tax-toggle">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">
                Display Taxes
            </label>
        </div>
    </div>

</div>

<!-- LISTINGS -->

<div class="row mt-4">

<% allListings.forEach(listing => { %>

<%
let coverImage;

if (listing.images && listing.images.length > 0) {
    coverImage = listing.images[0].url;
} else if (listing.image) {
    coverImage = listing.image.url;
} else {
    coverImage = "https://via.placeholder.com/600x400?text=No+Image";
}
%>

<div class="col-lg-3 col-md-6 col-sm-12 mb-4">

    <div class="listing-card">

        <!-- IMAGE -->

        <div class="card-img-container">

            <span class="guest-badge">
                🏆 Guest favourite
            </span>

            <form action="/wishlist/<%= listing._id %>" method="POST" class="wishlist-form">

                <button type="submit" class="wishlist-btn">

                    <% if (wishlist.includes(listing._id.toString())) { %>

                        <i class="fa-solid fa-heart text-danger"></i>

                    <% } else { %>

                        <i class="fa-regular fa-heart"></i>

                    <% } %>

                </button>

            </form>

            <a href="/listings/<%= listing._id %>" class="listing-link">

                <img
                    src="<%= coverImage %>"
                    class="listing-img"
                    alt="<%= listing.title %>"
                >

            </a>

        </div>

        <!-- DETAILS -->

        <div class="listing-info">

            <a href="/listings/<%= listing._id %>" class="listing-link">

                <h6 class="mb-1">
                    <%= listing.title %>
                </h6>

                <small class="text-muted">
                    <%= listing.location %>
                </small>

                <br>

                <strong>
                    ₹ <%= listing.price.toLocaleString("en-IN") %>
                </strong>

                / night

            </a>

        </div>

    </div>

</div>

<% }) %>

</div>

<script>
const taxSwitch = document.getElementById("switchCheckDefault");

taxSwitch.addEventListener("change", () => {

    const taxInfo = document.querySelectorAll(".tax-info");

    taxInfo.forEach(info => {
        info.style.display = taxSwitch.checked ? "inline" : "none";
    });

});
</script>