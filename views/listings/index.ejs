            </label>

        </div>

    </div>

</div>


<!-- =========================================================
     LISTINGS
========================================================= -->

<div class="row mt-4">

    <% allListings.forEach(listing => { %>


        <%

            let coverImage;

            if (
                listing.images &&
                listing.images.length > 0 &&
                listing.images[0].url
            ) {

                coverImage =
                    listing.images[0].url;

            }

            else if (
                listing.image &&
                listing.image.url
            ) {

                coverImage =
                    listing.image.url;

            }

            else {

                coverImage =
                    "https://via.placeholder.com/600x400?text=No+Image";

            }

        %>


        <!-- LISTING CARD -->

        <div class="col-lg-3 col-md-6 col-sm-12 mb-4">

            <div class="listing-card">


                <!-- IMAGE -->

                <div class="card-img-container">


                    <!-- GUEST FAVOURITE -->

                    <span class="guest-badge">

                        🏆 Guest favourite

                    </span>


                    <!-- WISHLIST -->

                    <form
                        action="/wishlist/<%= listing._id %>"
                        method="POST"
                        class="wishlist-form"
                    >

                        <button
                            type="submit"
                            class="wishlist-btn"
                            aria-label="Toggle wishlist"
                        >

                            <% if (
                                typeof wishlist !== "undefined" &&
                                wishlist &&
                                wishlist.includes(
                                    listing._id.toString()
                                )
                            ) { %>

                                <i
                                    class="fa-solid fa-heart text-danger"
                                ></i>

                            <% } else { %>

                                <i
                                    class="fa-regular fa-heart"
                                ></i>

                            <% } %>

                        </button>

                    </form>


                    <!-- LISTING IMAGE -->

                    <a
                        href="/listings/<%= listing._id %>"
                        class="listing-link"
                    >

                        <img
                            src="<%= coverImage %>"
                            class="listing-img"
                            alt="<%= listing.title %>"
                        >

                    </a>

                </div>


                <!-- DETAILS -->

                <div class="listing-info">

                    <a
                        href="/listings/<%= listing._id %>"
                        class="listing-link"
                    >


                        <!-- TITLE -->

                        <h6 class="mb-1">

                            <%= listing.title %>

                        </h6>


                        <!-- LOCATION -->

                        <small class="text-muted">

                            <%= listing.location %>

                        </small>


                        <br>


                        <!-- PRICE -->

                        <span class="price-container">

                            <strong>

                                ₹

                                <span
                                    class="price-value"
                                    data-price="<%= Number(listing.price) || 0 %>"
                                >

                                    <%= Number(
                                        listing.price || 0
                                    ).toLocaleString("en-IN") %>

                                </span>

                            </strong>


                            <!-- TAX -->

                            <span class="tax-info">

                                +18% GST

                            </span>

                        </span>


                        <span>

                            / night

                        </span>

                    </a>

                </div>

            </div>

        </div>


    <% }) %>

</div>


<!-- =========================================================
     TAX TOGGLE JAVASCRIPT
========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        const taxSwitch =
            document.getElementById(
                "switchCheckDefault"
            );


        if (!taxSwitch) {

            return;

        }


        taxSwitch.addEventListener(
            "change",
            function () {


                const priceElements =
                    document.querySelectorAll(
                        ".price-value"
                    );


                const taxInfoElements =
                    document.querySelectorAll(
                        ".tax-info"
                    );


                priceElements.forEach(
                    function (priceElement) {


                        const originalPrice =
                            Number(
                                priceElement.dataset.price
                            );


                        if (taxSwitch.checked) {


                            const tax =
                                Math.round(
                                    originalPrice * 0.18
                                );


                            const totalPrice =
                                originalPrice + tax;


                            priceElement.textContent =
                                totalPrice.toLocaleString(
                                    "en-IN"
                                );

                        }

                        else {


                            priceElement.textContent =
                                originalPrice.toLocaleString(
                                    "en-IN"
                                );

                        }

                    }
                );


                taxInfoElements.forEach(
                    function (info) {


                        info.style.display =
                            taxSwitch.checked
                                ? "inline"
                                : "none";

                    }
                );

            }
        );

    }
);

</script>