<% layout("/layouts/boilerplate") %>

<style>

    /* =========================================================
       FILTERS
    ========================================================= */

    #filters {

        display: flex;
        flex-wrap: wrap;
        align-items: center;

        margin-top: 1rem;

        gap: 0.25rem;
    }


    .filter {

        text-align: center;

        margin-right: 1.5rem;

        margin-top: 1rem;

        opacity: 0.7;

        color: inherit;

        text-decoration: none;
    }


    .filter:hover {

        opacity: 1;

        cursor: pointer;
    }


    /* =========================================================
       TAX INFO
    ========================================================= */

    .tax-info {

        display: none;

        color: #198754;

        font-size: 0.85rem;

        font-weight: 600;

        margin-left: 4px;
    }


    .tax-toggle {

        border: 1px solid #000;

        border-radius: 2rem;

        min-height: 3.25rem;

        padding: 0.75rem 1rem;

        margin-left: 1rem;

        margin-top: 1rem;

        display: flex;

        align-items: center;

        background: var(--main-bg, #e7e0e0);
    }


    .tax-toggle .form-check {

        display: flex;

        align-items: center;

        gap: 0.5rem;

        margin: 0;
    }


    .tax-toggle .form-check-input {

        cursor: pointer;

        width: 2.2rem;

        height: 1.2rem;

        margin: 0;
    }


    .tax-toggle .form-check-input:checked {

        background-color: #a50303;

        border-color: #a50303;
    }


    .tax-toggle .form-check-label {

        cursor: pointer;

        margin: 0;

        font-weight: 500;
    }


    /* =========================================================
       PRICE
    ========================================================= */

    .price-container {

        display: inline-flex;

        align-items: center;

        flex-wrap: wrap;

        gap: 3px;
    }


    .price-value {

        font-weight: 700;
    }


    /* =========================================================
       WISHLIST
    ========================================================= */

    .wishlist-form {

        position: absolute;

        top: 12px;

        right: 12px;

        z-index: 10;

        margin: 0;
    }


    .wishlist-btn {

        width: 40px;

        height: 40px;

        border: none;

        border-radius: 50%;

        background: rgba(255, 255, 255, 0.95);

        display: flex;

        align-items: center;

        justify-content: center;

        cursor: pointer;

        font-size: 1.2rem;

        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);

        transition:
            transform 0.2s ease,
            background 0.2s ease;
    }


    .wishlist-btn:hover {

        transform: scale(1.1);

        background: #fff;
    }


    .wishlist-btn .fa-heart.text-danger {

        color: #dc3545 !important;
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 768px) {

        #filters {

            gap: 0.5rem;
        }


        .filter {

            margin-right: 1rem;
        }


        .tax-toggle {

            margin-left: 0;
        }

    }

</style>


<!-- =========================================================
     FILTERS
========================================================= -->

<div id="filters">


